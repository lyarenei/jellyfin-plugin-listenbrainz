# Jellyfin server with a locally built ListenBrainz plugin baked in.
#
# The build context is generated by the integration test harness; it contains a
# single `plugin/<Name>_<Version>/` directory with the plugin artifacts and a
# meta.json manifest.
ARG JELLYFIN_IMAGE=docker.io/jellyfin/jellyfin
ARG JELLYFIN_TAG=10.11.11
FROM ${JELLYFIN_IMAGE}:${JELLYFIN_TAG}

# The base image declares /config and /cache as volumes, which means anything
# baked in there ends up in an anonymous volume with a lifetime of its own.
# Relocating every state directory into a plain image path keeps the plugin
# install deterministic and the server state ephemeral per container.
ENV JELLYFIN_DATA_DIR=/jellyfin-test/data \
    JELLYFIN_CONFIG_DIR=/jellyfin-test/data/config \
    JELLYFIN_LOG_DIR=/jellyfin-test/data/log \
    JELLYFIN_CACHE_DIR=/jellyfin-test/cache \
    XDG_CACHE_HOME=/jellyfin-test/cache

COPY plugin/ /jellyfin-test/data/plugins/
